{
  "$schema": "https://raw.githubusercontent.com/jolars/versionary/main/schemas/config.json",
  "version": 1,
  "release-type": "rust",
  "release-draft": true,
  "include-commit-authors": true,
  "release-reference-comments": "best-effort",
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "server.json",
          "field-path": "$.version",
        },
        {
          "type": "json",
          "path": "server.json",
          "field-path": "$.packages[0].version",
        },
      ],
    },
  },
}
